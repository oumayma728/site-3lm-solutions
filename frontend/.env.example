# 3LM Solutions frontend — copy to frontend/.env.local for local development.
# In production (Vercel), set it in Project Settings → Environment Variables.

# Address of the Django API, including /api. It is built into the pages at build time:
# after changing it on Vercel, redeploy.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
# Production example: NEXT_PUBLIC_API_URL=https://api.your-domain.tn/api
