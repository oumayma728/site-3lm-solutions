# 3LM Solutions backend — copy to backend/.env and fill in the values.
# In production, set the same names in the host's variables (never commit real values).

# Django
SECRET_KEY=replace-with-a-long-random-secret
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# Database (PostgreSQL via docker-compose: port 5433)
DB_NAME=devis_db
DB_USER=devis_user
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5433
# On a host that gives a single URL (Railway, Render…), set DATABASE_URL instead: it wins over DB_*.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Uploaded files (candidates' CVs). Production: the mount path of a persistent volume, e.g. /app/media
# MEDIA_ROOT=

# Email (Hostinger)
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_HOST_USER=contact@3lmsolutions.net
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=contact@3lmsolutions.net

# AI
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# CRM (accepted candidatures are sent there for analysis). CRM_API_KEY = the CRM's CANDIDATES_API_KEY.
CRM_API_URL=
CRM_API_KEY=

# ── Production only (leave commented locally) ───────────────────────────────
# DEBUG=false
# HTTPS=true                 # HTTPS redirect, secure cookies, HSTS
# SECURE_HSTS_SECONDS=3600   # raise to 31536000 once everything works over HTTPS
# NUM_PROXIES=1              # real visitor IP behind the host's proxy (rate limits)
# WEB_CONCURRENCY=3          # gunicorn worker processes
# PURGE_SCHEDULER=true       # daily deletion of applications + CVs older than 6 months (privacy policy)
#                            # by hand: python manage.py purge_candidatures --dry-run
# LOG_LEVEL=INFO
